# Gemini API key (free tier) — get one at https://aistudio.google.com/apikey
# IMPORTANT: Replace with your real API key
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use. Flash / Flash-Lite models are on the free tier.
# Supported options: gemini-2.5-flash, gemini-2.5-flash-lite, gemini-3.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Directory where session JSON files are stored
DATA_DIR=data

# CORS - comma separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
